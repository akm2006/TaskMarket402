NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Venice AI
# Server-only. Do not prefix Venice secrets with NEXT_PUBLIC_.
AI_PROVIDER=venice
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=zai-org-glm-5-1

# Gemini development/testing AI provider only. Never present Gemini output as Venice output.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Chain configuration
BASE_CHAIN_ID=84532
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_CHAIN_NAME=base-sepolia
NEXT_PUBLIC_BASE_RPC_URL=
BASE_RPC_URL=
BASE_EXPLORER_URL=
USDC_CONTRACT_ADDRESS=

# Wallet and payment configuration
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
METAMASK_DELEGATION_ENV=
X402_PAY_TO_ADDRESS=
X402_SETTLEMENT_NETWORK=
X402_FACILITATOR_URL=
# Phase 4 only: simulated x402-style proof. Not real settlement.
X402_DEV_MODE=true
X402_DEV_PAYMENT_PROOF=

# 1Shot relayer
ONESHOT_API_KEY=
ONESHOT_BASE_URL=
ONESHOT_PROJECT_ID=

# Data APIs
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_CHAIN_ID=base

# Demo flags
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_ENABLE_MOCK_PAYMENTS=true
NEXT_PUBLIC_ENABLE_BLOCKED_PAYMENT_CASE=true
