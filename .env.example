NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Venice AI
# Server-only. Do not prefix Venice secrets with NEXT_PUBLIC_.
AI_PROVIDER=venice
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=zai-org-glm-5-1

# Gemini development/testing AI provider only. Never present Gemini output as Venice output.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Chain configuration
BASE_CHAIN_ID=84532
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_CHAIN_NAME=base-sepolia
NEXT_PUBLIC_BASE_RPC_URL=
BASE_RPC_URL=
BASE_EXPLORER_URL=
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Wallet and payment configuration
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
METAMASK_DELEGATION_ENV=
# Phase 7 only: public delegate/session address for requesting a scoped MetaMask mission-budget permission.
# Do not put private keys or mnemonics in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_METAMASK_SESSION_ACCOUNT_ADDRESS=
NEXT_PUBLIC_MISSION_PERMISSION_PERIOD_SECONDS=3600
X402_PAY_TO_ADDRESS=
X402_SETTLEMENT_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
# Phase 5 only: real x402 Contract Scanner golden path. Keep secrets server-only.
X402_CONTRACT_SCANNER_MODE=simulated
# Use a plain decimal to avoid dotenv `$` expansion; `\$0.001` is also valid if using a dollar prefix.
X402_CONTRACT_SCANNER_PRICE_USD=0.001
X402_CONTRACT_SCANNER_URL=
# Phase 8: real x402 for all specialist agents when each route is configured. Still server-side buyer authority, not user-delegated spend.
X402_WALLET_BEHAVIOR_MODE=simulated
X402_WALLET_BEHAVIOR_PRICE_USD=0.001
X402_WALLET_BEHAVIOR_URL=
X402_MARKET_CONTEXT_MODE=simulated
X402_MARKET_CONTEXT_PRICE_USD=0.001
X402_MARKET_CONTEXT_URL=
X402_BUYER_PRIVATE_KEY=
X402_LIVE_SMOKE=false
# Phase 4 only: simulated x402-style proof. Not real settlement.
X402_DEV_MODE=true
X402_DEV_PAYMENT_PROOF=

# 1Shot relayer
ONESHOT_API_KEY=
ONESHOT_BASE_URL=
ONESHOT_PROJECT_ID=

# Data APIs
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_CHAIN_ID=base

# Demo flags
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_ENABLE_MOCK_PAYMENTS=true
NEXT_PUBLIC_ENABLE_BLOCKED_PAYMENT_CASE=true
